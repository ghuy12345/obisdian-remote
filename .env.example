# Fine-grained GitHub token with Contents: Read and write on the vault repo ONLY.
VAULT_REPO_URL=https://x-access-token:github_pat_XXXX@github.com/OWNER/VAULT_REPO.git
VAULT_BRANCH=main
SYNC_INTERVAL_SECONDS=60
GIT_AUTHOR_NAME=Vault Brain
GIT_AUTHOR_EMAIL=vault-brain@sebaagency.com

# openssl rand -hex 32
API_TOKEN=
# openssl rand -hex 24   -> MCP URL is https://<your-domain>/<MCP_SECRET>/mcp
MCP_SECRET=
# Your public domain, e.g. brain.example.com (enables Host-header checks on MCP)
ALLOWED_HOSTS=

EMBEDDINGS_BASE_URL=https://openrouter.ai/api/v1
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=openai/text-embedding-3-small

WRITES_ENABLED=true
# Optional folder allowlists, comma separated, e.g. "Inbox,Claude"
WRITE_CREATE_DIRS=
WRITE_APPEND_DIRS=

# Local dev only (the Docker image uses /data)
# DATA_DIR=./data
